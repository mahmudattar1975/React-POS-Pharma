# Copy to .env and fill in before running onboarding. Nothing here is a secret by itself except
# ZATCA_OTP (entered per onboarding attempt, not stored) - but .env itself should never be committed.

# sandbox = ZATCA's public developer-portal environment (no real onboarding needed, for API shape
#   testing only - CSIDs issued here are NOT valid against `simulation` or `core`).
# simulation = ZATCA's simulation environment - requires a real OTP from your Fatoora portal
#   account, issues CSIDs that work against simulation only. Use this to test for real before
#   production. THIS IS THE RECOMMENDED STARTING ENVIRONMENT.
# production = ZATCA's live environment. Real invoices, real legal effect. Do not point here until
#   simulation has been fully validated.
ZATCA_ENV=simulation

# --- Taxpayer / seller identity - must match what's registered with ZATCA exactly ---
ZATCA_SELLER_NAME_EN=Al-Shifa Pharmacy
ZATCA_SELLER_NAME_AR=صيدلية الشفاء
ZATCA_VAT_NUMBER=300012345600003
ZATCA_CR_NUMBER=1010123456
# City, address etc. used in the UBL AccountingSupplierParty block.
ZATCA_STREET=King Fahd Road
ZATCA_CITY=Riyadh
ZATCA_POSTAL_CODE=12345
ZATCA_DISTRICT=Al Olaya
ZATCA_COUNTRY=SA

# --- CSR subject fields (see src/crypto/csrTemplate.ts - VERIFY against ZATCA's current CSR
#     generation tool / template before real onboarding; these fields are ZATCA-specific and have
#     changed between spec revisions in the past) ---
ZATCA_CSR_COMMON_NAME=PharmacyApp-POS-01
ZATCA_CSR_ORGANIZATION_UNIT=Riyadh Branch
ZATCA_CSR_ORGANIZATION_NAME=Al-Shifa Pharmacy
# EGS (Electronic Goods/Generation Solution) unit serial - format ZATCA expects: 1-<solution
# name>|2-<model>|3-<serial>. Placeholder below - must be a real, unique value per device.
ZATCA_CSR_SERIAL_NUMBER=1-PharmacyApp|2-POS|3-000001
# 1 = standard invoices, 2 = simplified invoices only. Most retail/pharmacy POS = 2 unless you also
# issue B2B standard invoices from this same device.
ZATCA_CSR_INVOICE_TYPE=1100

PORT=4300

# --- PharmaAxis ERP (XPH database) read-only integration ---
# Pulls real item master / batch-stock / customer data from the existing PharmaAxis .NET backend
# (which already talks to XPH), instead of Pharmacy-App's local seed data. Read-only: sales are
# still recorded only in Pharmacy-App's own local store, nothing is written back to XPH - see
# server/src/erp/README.md for why and what "read/write" would actually require.
ERP_API_BASE_URL=http://localhost:5000
# A real user's credentials on that backend - used only to authenticate this server's own read
# calls, not tied to any specific cashier. userid 1 / password 1 is a known-working demo login on
# this dev machine's backend (see SESSION_STATUS.md in OpenMind-FrontEnd-React) - replace with a
# real service account before this touches anything but local development.
ERP_SERVICE_USER_ID=1
ERP_SERVICE_PASSWORD=1
# Store/branch number (fstore_no) to scope item and stock lookups to. 0 has not been confirmed to
# mean "all stores" - verify against a real store number for this pharmacy before relying on it.
ERP_STORE_NO=0

# --- This app's OWN database (sales/invoices/returns) ---
# A brand-new, EMPTY database on the same SQL Server instance that hosts XPH, but with its own
# separate tables (see prisma/schema.prisma) - NOT the legacy ftotsalf_ph/ftrnsalf_ph tables, and
# NOT a connection to the XPH database itself. Run prisma/create-database.sql once first to create
# it, then fill in the real host/port/credentials below and run `npx prisma migrate dev` in server/
# to create this app's tables inside it.
DATABASE_URL="sqlserver://HOST:1433;database=PharmaDB;user=USER;password=PASSWORD;encrypt=true;trustServerCertificate=true"

