# Copy to .env and fill in before running onboarding. Nothing here is a secret by itself except
# ZATCA_OTP (entered per onboarding attempt, not stored) - but .env itself should never be committed.

# sandbox = ZATCA's public developer-portal environment (no real onboarding needed, for API shape
#   testing only - CSIDs issued here are NOT valid against `simulation` or `core`).
# simulation = ZATCA's simulation environment - requires a real OTP from your Fatoora portal
#   account, issues CSIDs that work against simulation only. Use this to test for real before
#   production. THIS IS THE RECOMMENDED STARTING ENVIRONMENT.
# production = ZATCA's live environment. Real invoices, real legal effect. Do not point here until
#   simulation has been fully validated.
ZATCA_ENV=simulation

# --- Taxpayer / seller identity - FIRST-RUN SEED ONLY ---
# The seller + device identity is stored server-side in data/zatca-state.json and edited in the
# app under Settings > ZATCA > Company & Device. These values are read once, when that stored
# identity is first created; after that the UI is the single source of truth for both the CSR
# (certificate) and the signed UBL invoice. They must match what's registered with ZATCA exactly.
ZATCA_SELLER_NAME_EN=Al-Shifa Pharmacy
ZATCA_SELLER_NAME_AR=صيدلية الشفاء
ZATCA_VAT_NUMBER=300012345600003
ZATCA_CR_NUMBER=1010123456
# City, address etc. used in the UBL AccountingSupplierParty block.
ZATCA_STREET=King Fahd Road
ZATCA_CITY=Riyadh
ZATCA_POSTAL_CODE=12345
ZATCA_DISTRICT=Al Olaya
ZATCA_COUNTRY=SA

# --- CSR / device identity - FIRST-RUN SEED ONLY (edited under Settings > ZATCA > Company &
#     Device; see src/crypto/csrTemplate.ts and src/store/identity.ts). The Common Name and EGS
#     serial are DERIVED from the device fields, not typed:
#       Common Name = <terminal>-<solution>-<release>
#       EGS serial  = 1-<solution>|2-<release>|3-<uuid>
#     The serial below is parsed into those parts when the identity is first created. ---
ZATCA_CSR_ORGANIZATION_UNIT=Riyadh Branch
ZATCA_CSR_SERIAL_NUMBER=1-PharmacyApp|2-POS|3-000001
# Invoice type flag: 0100 = simplified (B2C) only, 1000 = standard (B2B) only, 1100 = both.
# A pharmacy POS normally needs 0100 unless it also issues B2B tax invoices.
ZATCA_CSR_INVOICE_TYPE=0100

PORT=4300

# --- PharmaAxis ERP (XPH database) read-only integration ---
# Pulls real item master / batch-stock / customer data from the existing PharmaAxis .NET backend
# (which already talks to XPH), instead of Pharmacy-App's local seed data. Read-only: sales are
# still recorded only in Pharmacy-App's own local store, nothing is written back to XPH - see
# server/src/erp/README.md for why and what "read/write" would actually require.
ERP_API_BASE_URL=http://localhost:5000
# A real user's credentials on that backend - used only to authenticate this server's own read
# calls, not tied to any specific cashier. userid 1 / password 1 is a known-working demo login on
# this dev machine's backend (see SESSION_STATUS.md in OpenMind-FrontEnd-React) - replace with a
# real service account before this touches anything but local development.
ERP_SERVICE_USER_ID=1
ERP_SERVICE_PASSWORD=1
# Store/branch number (fstore_no) to scope item and stock lookups to. 0 has not been confirmed to
# mean "all stores" - verify against a real store number for this pharmacy before relying on it.
ERP_STORE_NO=0

# --- Wasfaty (وصفتي) / NUPCO dispensing + claims ---
# Phase 0 works with no NUPCO connection at all:
#   manual = pharmacist records the dispense from the patient's Wasfaty message (default)
#   mock   = built-in deterministic NUPCO simulator, for an end-to-end demo/test of the claim loop
#   direct = live NUPCO connection, driven ONLY by a signed contract file (fails closed without one)
#   hub    = same, through an approved integration hub
# Never set direct/hub until NUPCO onboarding has supplied the real operations, auth and mapping.
WASFATY_PROVIDER=manual
# sandbox | simulation | production - reported by GET /api/wasfaty/health, never guessed.
WASFATY_ENV=sandbox
# Contract file for direct/hub. Defaults to server/data/wasfaty-contract.json. See Wasfaty-API.md
# for the checklist and sample. There is no public NUPCO endpoint to put here by default.
# WASFATY_CONTRACT_FILE=C:\path\to\wasfaty-contract.json

# --- This app's OWN database (sales/invoices/returns) ---
# A brand-new, EMPTY database on the same SQL Server instance that hosts XPH, but with its own
# separate tables (see prisma/schema.prisma) - NOT the legacy ftotsalf_ph/ftrnsalf_ph tables, and
# NOT a connection to the XPH database itself. Run prisma/create-database.sql once first to create
# it, then fill in the real host/port/credentials below and run `npx prisma migrate dev` in server/
# to create this app's tables inside it.
DATABASE_URL="sqlserver://HOST:1433;database=PharmaDB;user=USER;password=PASSWORD;encrypt=true;trustServerCertificate=true"



# --- RSD (SFDA Drug Track & Trace) - Pharmacy Sale / Pharmacy Sale Cancel only ---
# mock = local simulated SFDA, no credentials needed (default). live = real SOAP endpoints.
RSD_MODE=mock
# test = SFDA test environment. production = real national movements; never use without approval.
RSD_ENV=test
# Credentials stay on the server. Never put these in the browser bundle or localStorage.
# RSD_TEST_GLN=
# RSD_TEST_USERNAME=
# RSD_TEST_PASSWORD=
# Test endpoints have no published default; set both before RSD_MODE=live.
# RSD_TEST_SALE_URL=
# RSD_TEST_CANCEL_URL=
# Production URLs default to the published endpoints, but the credentials never do.
# RSD_PROD_GLN=
# RSD_PROD_USERNAME=
# RSD_PROD_PASSWORD=
# RSD_PROD_SALE_URL=https://rsd.sfda.gov.sa/ws/PharmacySaleService/PharmacySaleService
# RSD_PROD_CANCEL_URL=https://rsd.sfda.gov.sa/ws/PharmacySaleCancelService/PharmacySaleCancelService
# A patient (direct) sale uses this to-GLN when no payer GLN is supplied.
# RSD_DIRECT_TO_GLN=0000000000000
# Placeholder PRESCRIPTIONID for OTC/direct sales until the ISD confirms a real value.
# RSD_DIRECT_PRESCRIPTION_ID=DIRECT-SALE
# RSD_TIMEOUT_MS=20000
# Ledger/mock files default to server/data/*.json (gitignored).
# RSD_DATA_FILE=
# RSD_MOCK_FILE=
