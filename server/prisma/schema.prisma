// Originally scoped to sales/invoices/returns only (see server/README.md) - Item/Batch/Offer were
// added afterward as a TEST catalog (see prisma/seed.ts): a mix of this app's existing fictional
// seed data (src/utils/seedData.ts) and a real snapshot copied once from XPH, so the app can be
// exercised against PharmaDB alone without a live ERP connection. The live, read-only XPH
// integration (server/src/erp/) still exists separately and is unaffected - this is not a
// replacement for it, and NOT the legacy ftotsalf_ph/ftrnsalf_ph tables (see erp/README.md's
// "Multi-branch" section for why those weren't used: incomplete scaffolding, no stock decrement, no
// safe invoice numbering).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// Mirrors src/types/sales.ts's SaleHeader - field-for-field, so mapping to/from the frontend type
// is a straight copy, not a reshaping exercise.
model Sale {
  id          String @db.NVarChar(100) @id @default(uuid())
  invoiceNo   String @db.NVarChar(100) @unique
  // Terminal that issued this document. Set explicitly by routes/sales.ts from this PC's
  // branch.json; the default only covers rows written before branch tagging existed.
  branchId    String @db.NVarChar(100) @default("cc-br-001")
  invoiceType String @db.NVarChar(100)  // 'simplified' | 'standard'
  date        DateTime
  createdAt   DateTime @default(now())

  customerId     String? @db.NVarChar(100)
  customerNameAr String? @db.NVarChar(100)
  customerNameEn String? @db.NVarChar(100)

  subtotalExclVat          Decimal  @db.Decimal(12, 3)
  totalDiscount            Decimal  @db.Decimal(12, 3)
  totalVatAmount           Decimal  @db.Decimal(12, 3)
  totalInclVat             Decimal  @db.Decimal(12, 3)
  totalIncentive           Decimal? @db.Decimal(12, 3)
  totalIncentiveClawedBack Decimal? @db.Decimal(12, 3)

  zatcaQrBase64 String @db.NVarChar(Max)
  zatcaStatus   String @db.NVarChar(100)  // ZatcaSubmissionStatus
  status        String @db.NVarChar(100)  // InvoiceStatus - 'completed' | 'returned' | 'partially_returned'
  cashierName   String @db.NVarChar(100)

  pointsEarned           Int?
  pointsRedeemed         Int?
  pointsEarnedClawedBack Int?
  pointsRedeemedRefunded Int?

  // PrescriptionInfo, inlined - at most one per sale, so no separate table.
  prescriptionSource       String? @db.NVarChar(100)
  prescriptionWasfatyRefNo String? @db.NVarChar(100)
  prescriberName           String? @db.NVarChar(100)
  prescriberId             String? @db.NVarChar(100)
  prescriptionId           String? @db.NVarChar(100)
  prescriptionDate         DateTime?
  patientNationalId        String? @db.NVarChar(100)

  lines            SaleLine[]
  payments         Payment[]
  returns          ReturnRecord[]
  incentiveRecords IncentiveRecord[]

  @@index([branchId])
  @@map("sales")
}

// Mirrors SaleLine.
model SaleLine {
  id     String @db.NVarChar(100) @id @default(uuid())
  saleId String @db.NVarChar(100)
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  itemId     String @db.NVarChar(100)
  itemNameAr String @db.NVarChar(100)
  itemNameEn String @db.NVarChar(100)
  batchId    String @db.NVarChar(100)
  batchNo    String @db.NVarChar(100)
  expiryDate DateTime

  qty       Int
  unitPrice Decimal @db.Decimal(12, 3)
  vatRate   Decimal @db.Decimal(6, 4)

  offerLabel          String? @db.NVarChar(100)
  manualDiscountType  String? @db.NVarChar(100)  // 'amount' | 'percent'
  manualDiscountValue Decimal? @db.Decimal(12, 3)

  discountAmount   Decimal @db.Decimal(12, 3)
  netExclVat       Decimal @db.Decimal(12, 3)
  vatAmount        Decimal @db.Decimal(12, 3)
  totalInclVat     Decimal @db.Decimal(12, 3)
  returnedQty      Int     @default(0)
  controlledStatus String? @db.NVarChar(100)

  // ---- Incentive / profit bonus (Phase A) -------------------------------------------
  incentiveType   String? @db.NVarChar(100)
  incentiveRate   Decimal? @db.Decimal(12, 4)
  incentiveAmount Decimal? @db.Decimal(12, 3)

  @@map("sale_lines")
}

// Mirrors Payment.
model Payment {
  id     String @db.NVarChar(100) @id @default(uuid())
  saleId String @db.NVarChar(100)
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  method                String @db.NVarChar(100)  // PaymentMethod - 'cash' | 'card' | 'insurance' | 'points' (SQL Server connector doesn't support native enums)
  amount                Decimal @db.Decimal(12, 3)
  cardNetwork           String? @db.NVarChar(100)
  insuranceCompany      String? @db.NVarChar(100)
  insuranceApprovalCode String? @db.NVarChar(100)

  @@map("payments")
}

// Mirrors ReturnHeader.
model ReturnRecord {
  id                String @db.NVarChar(100) @id @default(uuid())
  returnNo          String @db.NVarChar(100) @unique
  branchId          String @db.NVarChar(100) @default("cc-br-001")
  date              DateTime
  originalInvoiceId String @db.NVarChar(100)
  sale              Sale     @relation(fields: [originalInvoiceId], references: [id])
  originalInvoiceNo String @db.NVarChar(100)
  totalRefund       Decimal  @db.Decimal(12, 3)
  reason            String @db.NVarChar(100)

  lines ReturnLine[]

  @@index([branchId])
  @@map("return_records")
}

// Mirrors ReturnLine.
model ReturnLine {
  id             String @db.NVarChar(100) @id @default(uuid())
  returnRecordId String @db.NVarChar(100)
  returnRecord   ReturnRecord @relation(fields: [returnRecordId], references: [id], onDelete: Cascade)

  saleLineId   String @db.NVarChar(100)
  itemNameEn   String @db.NVarChar(100)
  qty          Int
  refundAmount Decimal @db.Decimal(12, 3)

  @@map("return_lines")
}

// The shared branch master: ONE list in PharmaDB, editable from Settings > Branches on any
// terminal. A terminal's OWN branch is selected by server/config/branch.json (gitignored) - never
// by this table alone, so a cashier cannot accidentally post a sale to another pharmacy.
// Deactivate instead of deleting: invoice prefixes and history still reference the code.
model Branch {
  id           String @db.NVarChar(100) @id  // system id, e.g. cc-br-001
  code         String @db.NVarChar(100) @unique  // short prefix used on invoices, e.g. RIY
  nameEn       String @db.NVarChar(100)
  nameAr       String @db.NVarChar(100)
  address      String? @db.NVarChar(100)
  phone        String? @db.NVarChar(100)
  vatNumber    String? @db.NVarChar(100)
  crNumber     String? @db.NVarChar(100)
  glnNo        String? @db.NVarChar(100)  // GS1 location number for RSD
  costCenterId String? @db.NVarChar(100)  // links to the app's branch cost center for reporting
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([isActive])
  @@map("branches")
}

// Mirrors src/types/catalog.ts's Item. id is kept exactly as the app already assigns it elsewhere
// ('itm-1' for fictional seed items, 'erp-<itemNo>' for real XPH items - see
// store/catalogStore.ts's upsertErpItem) rather than a generated key, so rows copied from either
// source need no id translation at all.
model Item {
  id       String @db.NVarChar(100) @id
  // Internal item code (recommended master's ItemCode). Mirrors the frontend Item.itemNo; nullable
  // so older rows and ERP scans without a code keep loading unchanged.
  itemNo   Int?
  // Barcode stays NVARCHAR(100) text: numeric types would drop the leading zeros printed on packs.
  barcode  String @db.NVarChar(100) @unique
  // Pack GTIN when it differs from the scannable barcode.
  gtin     String? @db.NVarChar(32)

  // Bilingual and pharmaceutical description.
  nameAr                String  @db.NVarChar(100)
  nameEn                String  @db.NVarChar(100)
  genericName           String? @db.NVarChar(200)
  activeIngredient      String? @db.NVarChar(200)
  strength              String? @db.NVarChar(50)
  dosageForm            String? @db.NVarChar(100)
  routeOfAdministration String? @db.NVarChar(100)

  // Classification. `category` stays the free-text label consumed by POS/cost-center rules;
  // categoryId (main) and subCategoryId both point at Categories; brandId and
  // manufacturerId point at their own masters. Text keys sit beside the FKs they mirror.
  categoryId    Int?   @map("categoryId")
  subCategoryId Int?
  category      String @db.NVarChar(100)
  brandId       Int?
  itemType      String? @db.NVarChar(50)
  // Manufacturer: the company number the frontend stores and the matching FK are the SAME link.
  // The dbo.items trigger keeps them in sync: the text key wins, an unmatched key clears the FK,
  // and a numeric-only write is filled from Manufacturers.CompanyNo.
  manufacturerId Int?
  manufacturerNo String? @db.NVarChar(50)
  // Preferred vendor: same invariant (CustVendor.VendorNo is the stable key, VendorID the FK).
  vendorId Int?
  vendorNo String? @db.NVarChar(50)

  // Unit of measure. `unit` stays the free-text label for POS/receipts and for legacy rows whose
  // text has no matching Units row yet.
  unitId   Int?
  unit     String @db.NVarChar(100)
  packSize Int?

  // Regulatory / pharmaceutical metadata. controlledStatus remains the single detailed source
  // (prescription / schedule_a..e); the booleans below are convenience filters for the same facts.
  controlledStatus   String? @db.NVarChar(100)
  drugClass          String? @db.NVarChar(100)
  atcCode            String? @db.NVarChar(20)
  sfdaRegistrationNo String? @db.NVarChar(50)
  countryOfOrigin    String? @db.NVarChar(100)
  storageCondition   String? @db.NVarChar(100)

  // Pricing and tax. Decimal money columns, never float.
  basePrice Decimal @db.Decimal(12, 3)
  // Optional item-level cost entered in the Item Master (Item Master > Pricing & tax). Receiving
  // still writes the authoritative per-batch cost on Batch.costPrice; this is the master/default
  // value shared with every terminal. Nullable so older rows keep loading unchanged.
  costPrice Decimal? @db.Decimal(12, 3)
  vatRate   Decimal @db.Decimal(6, 4)

  // Stock policy. reorderLevel is the existing trigger point; the min/max pair is the recommended
  // bound pair and stays separate from it.
  reorderLevel Int
  minimumStock Int?
  maximumStock Int?

  // Every BIT column is last in dbo.items (migration 20261127130000). Operational flags come first,
  // then clinical/financial flags. Names, not ordinals, are used by every query and the sync trigger.
  isActive               Boolean @default(true)
  requiresBatchTracking  Boolean
  requiresExpiryDate     Boolean @default(true)
  requiresSerialNumber   Boolean @default(false)
  requiresPrescription   Boolean @default(false)
  isControlledDrug       Boolean @default(false)
  isNarcotic             Boolean @default(false)
  isTaxable              Boolean @default(true)
  isTemperatureSensitive Boolean @default(false)

  // NoAction on both sides keeps this relation out of Prisma's cyclic referential-action chain
  // (Item -> ItemCategory -> Item). A category still in use is rejected instead of silently
  // rewriting item rows.
  // Two separate relations into the same self-referencing category master: 3-level hierarchy is
  // Main Category (categoryId) -> Subcategory (subCategoryId) -> Item.
  categoryMaster    ItemCategory?   @relation("ItemMainCategory", fields: [categoryId], references: [categoryId], onDelete: NoAction, onUpdate: NoAction)
  subCategoryMaster ItemCategory?   @relation("ItemSubCategory", fields: [subCategoryId], references: [categoryId], onDelete: NoAction, onUpdate: NoAction)
  brand             Brand?          @relation(fields: [brandId], references: [brandId], onDelete: NoAction, onUpdate: NoAction)
  unitMaster        Unit?           @relation(fields: [unitId], references: [unitId], onDelete: NoAction, onUpdate: NoAction)
  manufacturer      Manufacturer?   @relation(fields: [manufacturerId], references: [manufacturerId], onDelete: NoAction, onUpdate: NoAction)
  vendor            Vendor?         @relation(fields: [vendorId], references: [vendorId], onDelete: NoAction, onUpdate: NoAction)
  batches           Batch[]
  offers         Offer[]
  incentives     IncentiveItem[]

  @@index([itemNo])
  @@index([gtin])
  @@index([brandId])
  @@index([unitId])
  @@index([subCategoryId])
  @@index([manufacturerId])
  @@index([manufacturerNo])
  @@index([vendorId])
  @@index([vendorNo])
  @@index([categoryId])
  @@index([atcCode])
  @@index([sfdaRegistrationNo])
  @@index([isActive])
  @@map("items")
}

// Brand master for the Item Master. BrandID / BrandCode / bilingual names / IsActive are the
// original four fields; ManufacturerID and CountryOfOrigin were added at the owner's request so a
// brand can record who makes it and where it comes from. No brand values exist in the catalogue yet,
// so the table starts empty. The ManufacturerID FK is created after Manufacturers exists (migration
// 20261126120000); this model only declares the relation.
model Brand {
  brandId        Int     @id @default(autoincrement()) @map("BrandID")
  brandCode      String  @unique @map("BrandCode") @db.NVarChar(50)
  nameEn         String  @map("BrandNameEn") @db.NVarChar(150)
  nameAr         String  @map("BrandNameAr") @db.NVarChar(150)
  manufacturerId Int?    @map("ManufacturerID")
  countryOfOrigin String? @map("CountryOfOrigin") @db.NVarChar(100)
  isActive       Boolean @default(true) @map("IsActive")
  manufacturer   Manufacturer? @relation(fields: [manufacturerId], references: [manufacturerId], onDelete: NoAction, onUpdate: NoAction)
  items          Item[]

  @@index([manufacturerId])
  @@index([isActive])
  @@map("BrandMaster")
}

// Unit-of-measure master. Seeded with the unit codes/names already present in the POS catalogue so
// items.unit can be backfilled to unitId without changing what cashiers see on screen.
model Unit {
  unitId   Int     @id @default(autoincrement()) @map("UnitID")
  unitCode String  @unique @map("UnitCode") @db.NVarChar(50)
  nameAr   String  @map("UnitNameAr") @db.NVarChar(150)
  nameEn   String  @map("UnitNameEn") @db.NVarChar(150)
  isActive Boolean @default(true) @map("IsActive")
  items    Item[]

  @@index([isActive])
  @@map("Units")
}

// Shelf/store location master for the Item Master dropdown. Item.location stays an app-level text
// label (dbo.items has no location column yet), so older local catalogues keep working unchanged;
// the dropdown simply stores Locations.LocationNameEn into that text field.
model Location {
  locationId   Int     @id @default(autoincrement()) @map("LocationID")
  locationCode String  @unique @map("LocationCode") @db.NVarChar(50)
  nameAr       String  @map("LocationNameAr") @db.NVarChar(150)
  nameEn       String  @map("LocationNameEn") @db.NVarChar(150)
  isActive     Boolean @default(true) @map("IsActive")

  @@index([isActive])
  @@map("Locations")
}

// Manufacturer / company master. Mirrors src/types/manufacturer.ts: CompanyNo is the stable number
// stored in Item.manufacturerNo, so renaming a company never breaks the item link. The five seeded
// rows come from src/utils/seedData.ts's seedManufacturers.
model Manufacturer {
  manufacturerId Int     @id @default(autoincrement()) @map("ManufacturerID")
  companyNo      Int     @unique @map("CompanyNo")
  nameAr         String  @map("ManufacturerNameAr") @db.NVarChar(150)
  nameEn         String  @map("ManufacturerNameEn") @db.NVarChar(150)
  details        String? @map("Details") @db.NVarChar(2000)
  isActive       Boolean @default(true) @map("IsActive")
  updatedAt      DateTime? @map("UpdatedAt")
  items          Item[]
  brands         Brand[]

  @@index([isActive])
  @@map("Manufacturers")
}

// Purchasing party master (FCODCSVN-style). Mirrors src/types/purchasing.ts's Vendor: vendors
// (TypeFlag 1) and business customers (TypeFlag 2) share [dbo].[CustVendor] (renamed from Vendors in
// migration 20261127110000), and VendorNo is the stable key stored in Item.vendorNo. The six seeded
// rows come from seedData.ts's seedVendors.
model Vendor {
  vendorId            Int     @id @default(autoincrement()) @map("VendorID")
  vendorNo            String  @unique @map("VendorNo") @db.NVarChar(50)
  typeFlag            Int     @map("TypeFlag")
  nameAr              String  @map("VendorNameAr") @db.NVarChar(150)
  nameEn              String  @map("VendorNameEn") @db.NVarChar(150)
  phone               String  @map("Phone") @db.NVarChar(50)
  vatNumber           String? @map("VatNumber") @db.NVarChar(50)
  category            String? @map("Category") @db.NVarChar(100)
  creditLimit         Decimal? @map("CreditLimit") @db.Decimal(12, 2)
  settlementDays      Int?    @map("SettlementDays")
  vatType             Int?    @map("VatType")
  glnNo               String? @map("GlnNo") @db.NVarChar(50)
  bonusDiscountSetNo  Int?    @map("BonusDiscountSetNo")
  limitationSetNo     Int?    @map("LimitationSetNo")
  notes               String? @map("Notes") @db.NVarChar(2000)
  isActive            Boolean @default(true) @map("IsActive")
  updatedAt           DateTime? @map("UpdatedAt")
  items               Item[]

  @@index([typeFlag])
  @@index([isActive])
  @@map("CustVendor")
}

// Pharmacy category master, mapped to [dbo].[Categories] (renamed from ItemCategories in migration
// 20261126160000). Stable numeric id, unique code, bilingual names, optional parent for hierarchy,
// and an active flag. Main categories are top-level (ParentCategoryID NULL); subcategories point at
// their main category, so the three-level system is Main -> Subcategory -> Item.
model ItemCategory {
  categoryId       Int     @id @default(autoincrement()) @map("CategoryID")
  categoryCode     String  @unique @map("CategoryCode") @db.NVarChar(50)
  nameAr           String  @map("CategoryNameAr") @db.NVarChar(150)
  nameEn           String  @map("CategoryNameEn") @db.NVarChar(150)
  parentCategoryId Int?    @map("ParentCategoryID")
  isActive         Boolean @default(true) @map("IsActive")

  parent          ItemCategory?  @relation("ItemCategoryHierarchy", fields: [parentCategoryId], references: [categoryId], onDelete: NoAction, onUpdate: NoAction)
  children        ItemCategory[] @relation("ItemCategoryHierarchy")
  items           Item[]         @relation("ItemMainCategory")
  subCategoryItems Item[]        @relation("ItemSubCategory")

  @@map("Categories")
}

// Mirrors Batch.
model Batch {
  id                      String @db.NVarChar(100) @id
  // Stock is owned by one branch. Two branches can hold the same item/batchNo independently, so
  // every stock lookup (and the "top up vs create" decision) must filter on branchId as well.
  branchId                String @db.NVarChar(100) @default("cc-br-001")
  itemId                  String @db.NVarChar(100)
  item                    Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  batchNo                 String @db.NVarChar(100)
  expiryDate              DateTime
  receivedDate            DateTime
  qtyOnHand               Int
  purchasePrice           Decimal  @db.Decimal(12, 3)
  purchaseDiscountPercent Decimal  @db.Decimal(6, 4)
  costPrice               Decimal  @db.Decimal(12, 3)
  gtin                    String? @db.NVarChar(100)
  salePriceOverride       Decimal? @db.Decimal(12, 3)

  @@index([branchId, itemId, batchNo])
  @@map("batches")
}

// Mirrors Offer. No real source for this in XPH at all (confirmed live) - every row here is
// fictional demo data, copied as-is from seedData.ts, not a snapshot of anything real.
model Offer {
  id         String @db.NVarChar(100) @id
  itemId     String @db.NVarChar(100)
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type       String @db.NVarChar(100)  // OfferType - 'percent' | 'value' | 'bogo'
  percent    Decimal? @db.Decimal(6, 4)
  value      Decimal? @db.Decimal(12, 3)
  buyQty     Int?
  freeQty    Int?
  activeFrom DateTime
  activeTo   DateTime
  label      String @db.NVarChar(100)

  @@map("offers")
}

// ---- Incentive / profit bonus (Phase A) ---------------------------------------------------
model IncentiveItem {
  id            String @db.NVarChar(100) @id @default(cuid())
  itemId        String @db.NVarChar(100)
  item          Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  incentiveType String @db.NVarChar(100)  // 'percent' | 'amount'
  rate          Decimal  @db.Decimal(12, 4)
  activeFrom    DateTime
  activeTo      DateTime
  branchNo      Int?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  records IncentiveRecord[]

  @@map("incentive_items")
}

model IncentiveRecord {
  id              String @db.NVarChar(100) @id @default(cuid())
  saleId          String @db.NVarChar(100)
  sale            Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  invoiceNo       String @db.NVarChar(100)
  invoiceDate     DateTime
  itemId          String @db.NVarChar(100)
  itemNameEn      String @db.NVarChar(100)
  qty             Int
  saleAmount      Decimal  @db.Decimal(12, 3)
  incentiveType   String @db.NVarChar(100)  // 'percent' | 'amount'
  rate            Decimal  @db.Decimal(12, 4)
  incentiveAmount Decimal  @db.Decimal(12, 3)
  cashierName     String @db.NVarChar(100)
  branchNo        Int?
  createdAt       DateTime @default(now())

  incentiveItemId String? @db.NVarChar(100)
  incentiveItem   IncentiveItem? @relation(fields: [incentiveItemId], references: [id])

  @@map("incentive_records")
}
